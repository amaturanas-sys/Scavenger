#!/bin/sh
# El pre-push del Codespace (lo activa .devcontainer/setup.sh: git config core.hooksPath .githooks).
# 1) Nunca se sube a main ni a las ramas de Claude: en la v0.10.3, un push desde un Codespace viejo
#    reemplazo la rama de Claude con el codigo de la v0.9.0 y el repositorio quedo dividido en tres.
# 2) Las guardas (tools/ci/guardas.py) se muestran, pero no frenan el push de una rama a medias:
#    subirla al terminar la sesion es lo que la salva. El CI si frena el PR hasta arreglarlas.
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
    refs/heads/main | refs/heads/claude/*)
        echo "pre-push: no se sube a ${remote_ref#refs/heads/}. Tu rama es cline/<tarea> o copilot/<tarea> (docs/GUIA_IA.md)." >&2
        exit 1
        ;;
    esac
done
if ! python3 tools/ci/guardas.py; then
    echo "pre-push: las guardas fallan (arriba). El push sigue, pero el CI frenara el PR hasta arreglarlas." >&2
fi
exit 0
